# Copy to .env for local runs. Never commit real values.
# Postgres of docker-compose.yml (`docker compose up postgres dynamodb dynamodb-init`).
DATABASE_URL=postgres://cuentas:cuentas@localhost:5432/cuentas
# Server for the tests: each test creates its own database there.
TEST_DATABASE_URL=postgres://cuentas:cuentas@localhost:5432/cuentas
PORT=8080
# 1 = load seeds/0001_ejemplo_amanda.sql (and seeds/0002_demo_app.sql when DEMO_* are set).
SEED=1
# Password of the `admin` account for the /v1 admin routes. Required in production; no admin without it.
ADMIN_CLAVE=
# Demo tallerista for the app (only with SEED=1).
DEMO_USUARIO=
DEMO_CLAVE=
# simulate (default) or live. Live reads the Pey key from Secrets Manager.
PEY_MODE=simulate
PEY_SECRET_ID=pagacontufoto/pey
PEY_BASE_URL=https://api.pey.mx
# Charges this amount for everything (options, pagos.monto_mxn and Pey), e.g. 1 for real-money team tests. Empty = real amounts.
PEY_AMOUNT_OVERRIDE=
# Only for local webhook tests in simulate mode.
PEY_WEBHOOK_SECRET=
# DynamoDB table for Pey charges and webhooks; empty keeps them in memory.
PEY_EVENTS_TABLE=
DYNAMODB_ENDPOINT=
AWS_REGION=mx-central-1
# Month whose fee counts as "ya pagó".
CURRENT_PERIOD=2026-12
WORKSHOP_CAPACITY=12
